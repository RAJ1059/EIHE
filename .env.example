# Public site URL, used for metadata (Open Graph, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LMS backend (the separate NestJS server in /server). By default the
# frontend proxies /api/* to this address server-side (see next.config.ts)
# so the browser never calls it directly — you normally don't need to set
# either of these unless the backend runs somewhere other than :4000, or
# you want the browser to bypass the proxy and call it directly.
# LMS_API_PROXY_TARGET=http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google Sign-In. Same OAuth 2.0 Client ID as the backend's GOOGLE_CLIENT_ID
# (server/.env) — this one is public by design (Google client IDs are not
# secret). Until it's set, the "Sign in with Google" button stays hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
