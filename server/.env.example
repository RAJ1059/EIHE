# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/eihe-lms?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Bootstrap admin (used only by `npm run seed:admin`)
ADMIN_EMAIL=admin@europeanihe.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=EIHE Admin

# Razorpay (checkout). Get test keys from the Razorpay Dashboard →
# Settings → API Keys. Until these are set, course checkout returns a
# clear "payment gateway not configured" error instead of failing silently.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
